function cargarCasosReales() {
  const h = hojaPorNombre(CFG.HOJAS.CASOS);
  const previas = Math.max(h.getLastRow() - 1, 0);
  if (previas > 0) h.deleteRows(2, previas);
  const semanas = semanasVencimiento();
  let n = 0;
  let sinDefuncion = [];
  CASOS_REALES.forEach(function (c) {
    const defuncion = aFecha(c.fechaDefuncion);
    const vencimiento = aFecha(c.fechaVencimiento);
    const vencFinal = vencimiento || (defuncion ? new Date(defuncion.getFullYear(), defuncion.getMonth(), defuncion.getDate() + semanas * 7) : '');
    const asignacion = aFecha(c.fechaAsignacion) || hoy();
    const id = 'CS-' + String(n + 1).padStart(4, '0');
    if (!defuncion) sinDefuncion.push(normalizarTexto(c.caso));
    h.appendRow([
      id,
      normalizarTexto(c.caso),
      normalizarTexto(c.cc),
      c.edad === '' || c.edad === undefined ? '' : Number(c.edad),
      normalizarTexto(c.gestaciones),
      normalizarTexto(c.evento),
      defuncion || '',
      asignacion,
      vencFinal,
      aFecha(c.fechaRealizacion) || '',
      normalizarTexto(c.periodo) || (defuncion ? periodoEpidemiologico(defuncion) : ''),
      normalizarTexto(c.eapb),
      normalizarTexto(c.ipsPrimerNivel),
      normalizarTexto(c.ipsParto),
      normalizarTexto(c.observacion),
      normalizarTexto(c.causaMuerte),
      normalizarTexto(c.conclusion),
      normalizarTexto(c.profesional),
      normalizarTexto(c.intervinientes),
      normalizarTexto(c.seguimiento),
      normalizarTexto(c.otrosDatos)
    ]);
    n++;
  });
  generarHojaAlertas();
  construirTablero();
  SpreadsheetApp.flush();
  return {
    cargados: n,
    eliminadas: previas,
    sinDefuncion: sinDefuncion,
    motivo: 'Casos reales cargados desde el consolidado.'
  };
}
